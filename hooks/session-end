#!/usr/bin/env bash
set -euo pipefail
ROOT="${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}"
if [[ -z "$ROOT" ]]; then
  ROOT="$(cd "$(dirname "$0")/.." && pwd)"
  # These hooks ship only in the Grok plugin, so a bare invocation is Grok.
  # detect_kind keys on hook-scoped vars; without this the session registers
  # as "other" and no UDS teammate is published. Only set in this branch --
  # if CLAUDE_PLUGIN_ROOT supplied ROOT, claiming Grok would let a Claude
  # session adopt a Grok identity.
  export GROK_PLUGIN_ROOT="$ROOT"
fi
exec "$ROOT/scripts/agent-bus" hook session-end
