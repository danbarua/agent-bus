<?xml version="1.0" encoding="UTF-8"?>
<!--
  One service per address (kind:name), e.g. desktop:claude. A second address
  is a second copy of this file with different values, not a flag added here.

  Don't hand-edit the placeholders below with real values and expect launchd
  to expand `~`, `$HOME`, or any shell variable; it doesn't. Use
  bridge-service.sh install/render, which substitutes them for you. See
  docs/running-the-bridge.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.framesift.agent-bridge.__LABEL__</string>

  <!-- Must be the installed binary (uv tool install agent-bus-team), not a
       path into a git checkout: a checkout can change or disappear under
       a running service. -->
  <!-- The peer value is optional. An empty <string></string> here means no
       peer; leave it blank unless this is a `remote` kind address that
       pairs with another one. -->
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__/agent-bridge</string>
    <string>start</string>
    <string>--kind</string>
    <string>__KIND__</string>
    <string>--name</string>
    <string>__NAME__</string>
    <string>--peer</string>
    <string>__PEER__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart automatically if the process dies or is killed. -->
  <key>KeepAlive</key>
  <true/>
  <!-- Minimum 60 seconds between restarts, so a persistent failure retries
       once a minute instead of in a tight crash loop against a billed
       endpoint. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <!-- Check this file first when troubleshooting: it's the only record of
       what this service has done. -->
  <key>StandardOutPath</key>
  <string>__LOGS__/__LABEL__.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/__LABEL__.log</string>

  <!-- A launchd service gets almost no environment by default. Everything
       below is set explicitly because it would otherwise be missing. -->
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Needed so the bridge can run `security` (Keychain) and `ps` (peer
         liveness checks) as subprocesses. -->
    <key>PATH</key>
    <string>__BIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>

    <!-- Needed for date parsing to work the same way it does in a terminal.
         Without it, a service and a terminal can each wrongly decide the
         other's live entries are stale. -->
    <key>LC_ALL</key>
    <string>C</string>

    <!-- How much this service logs to $XDG_STATE_HOME/agent-bus/agent-bus.jsonl.
         info: routine activity (forwarded/delivered messages, roster
               publishes) plus failures. This is the default. Without it,
               only failures show up, which makes a running-but-quiet
               service impossible to tell apart from a broken one.
         trace: also logs full message contents. Turn on only while actively
                debugging one address, then turn back off.
         off / quiet: nothing at all. -->
    <key>AGENT_BUS_LOG_LEVEL</key>
    <string>info</string>

    <!-- Not set here: AGENT_BRIDGE_LOG_FILE (redirects only this bridge's
         log lines) and AGENT_BUS_LOG_FILE (redirects every agent-bus log
         line into one file, mixing this bridge in with everything else on
         the machine). Add whichever one you actually want, per address, if
         the shared default file isn't what you need. -->
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
