    "state": "open",
    "locked": false,
    "title": "Drain the body on every POST refusal, not just the webhook's",
    "user": {
      "login": "danbarua",
      "id": 469192,
      "node_id": "MDQ6VXNlcjQ2OTE5Mg==",
      "avatar_url": "https://avatars.githubusercontent.com/u/469192?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/danbarua",
      "html_url": "https://github.com/danbarua",
      "followers_url": "https://api.github.com/users/danbarua/followers",
      "following_url": "https://api.github.com/users/danbarua/following{/other_user}",
      "gists_url": "https://api.github.com/users/danbarua/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/danbarua/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/danbarua/subscriptions",
      "organizations_url": "https://api.github.com/users/danbarua/orgs",
      "repos_url": "https://api.github.com/users/danbarua/repos",
