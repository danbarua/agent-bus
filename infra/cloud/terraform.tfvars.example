# Copy to terraform.tfvars and fill in. Gitignored (infra/**/*.tfvars), because
# it holds the billing account id.
#
# Terraform reads terraform.tfvars automatically: no exports, no -var flags, no
# prompts. TF_VAR_* works too, but has to be exported in every new shell --
# which is how you end up hand-typing a billing account into a prompt halfway
# through an apply.
#
#   billing_account_id <- GOOGLE_CLOUD_BILLING_ACCOUNT in the repo root .env

billing_account_id = "000000-000000-000000"

# The public hostname. Required, and kept out of the repository on purpose:
# it is where this person's coding agents can be messaged. Certificate
# transparency makes it discoverable the moment a cert issues -- that is what
# the consent passphrase and the redirect allowlist are for -- but there is no
# reason to hand it to anyone who reads the source.
hostname = "bus.example.com"

# Required, and no longer defaulted: forgetting it used to mean replacing the
# service with Google's demo container, quietly. Bump this to promote a build;
# the tag is what `cloud-v*` produced, and `/health` reports the same string
# because the image carries it.
image = "us-central1-docker.pkg.dev/agent-bus-cloud/cloud/server:cloud-v0.0.3"

# Adding an entry here makes AGENT_BUS_CLOUD_PASSPHRASE required -- it is what
# makes the consent flow reachable. Empty is a valid bridge-only deployment,
# but say so explicitly: an apply that omitted this once was one confirmation
# away from emptying the live allowlist and locking every connector out of
# re-registering.
allowlist = {
  # "https://claude.ai/api/mcp/auth_callback" = "desktop:claude"
}
